@model ReportViewModel
@{
    ViewData["Title"] = "Reports";
    string[] statuses = { "Pending", "Shipped", "Completed", "Cancelled" };
    var routes = new Dictionary<string, string?>
    {
        ["search"] = Model.Search, ["status"] = Model.Status,
        ["from"] = Model.From?.ToString("yyyy-MM-dd"), ["to"] = Model.To?.ToString("yyyy-MM-dd")
    };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Orders Report</h3>
    <a asp-action="Export" asp-all-route-data="routes" class="btn btn-success">Export to Excel</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-3"><input name="search" value="@Model.Search" class="form-control" placeholder="Search customer, product, city..." /></div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var s in statuses) { <option value="@s" selected="@(s == Model.Status)">@s</option> }
        </select>
    </div>
    <div class="col-md-2"><input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" title="From" /></div>
    <div class="col-md-2"><input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" title="To" /></div>
    <div class="col-auto"><button class="btn btn-primary">Filter</button> <a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div>
</form>

<div class="alert alert-light border d-flex justify-content-between">
    <span>@Model.TotalCount.ToString("N0") order(s) found</span>
    <strong>Total: $@Model.TotalAmount.ToString("N2")</strong>
</div>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light"><tr><th>#</th><th>Date</th><th>Customer</th><th>City</th><th>Product</th><th>Qty</th><th class="text-end">Amount</th><th>Status</th></tr></thead>
      <tbody>
      @if (!Model.Items.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No orders match your filters.</td></tr> }
      @foreach (var o in Model.Items)
      {
          var badge = o.Status switch { "Completed" => "success", "Shipped" => "info", "Pending" => "warning", _ => "secondary" };
          <tr>
              <td>@o.Id</td><td>@o.OrderDate.ToString("dd MMM yyyy")</td><td>@o.Customer?.Name</td><td>@o.Customer?.City</td>
              <td>@o.Product?.Name</td><td>@o.Quantity</td><td class="text-end">$@o.Amount.ToString("N2")</td>
              <td><span class="badge text-bg-@badge">@o.Status</span></td>
          </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@if (Model.TotalPages > 1)
{
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav class="mt-3"><ul class="pagination justify-content-center">
        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">Previous</a></li>
        @for (var i = start; i <= end; i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">@i</a></li>
        }
        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">Next</a></li>
    </ul></nav>
}
